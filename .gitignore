# Wails
/build/bin/
/frontend/wailsjs/

# Frontend build output (regenerated by `npm run build`). The directory itself
# stays tracked because main.go embeds it, and `go build` needs it to exist.
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/node_modules/
/frontend/package.json.md5

# Go
*.exe
*.test
*.out

# Task checksum cache
/.task/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
