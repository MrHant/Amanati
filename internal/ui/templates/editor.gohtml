{{- define "editor.gohtml" -}}
{{/* Initial editor state for Alpine; read back via dataset in requestEditor(). */}}
<div id="editor-data" hidden data-state="{{ json . }}"></div>

<form class="flex h-full min-h-0 flex-col" x-data="requestEditor()"
      @keydown.window.ctrl.enter.prevent="$el.requestSubmit()"
      hx-post="/api/send" hx-target="#response-pane" hx-swap="innerHTML"
      hx-indicator="#send-indicator" hx-disabled-elt="#send-button">

  <input type="hidden" name="collection-id" :value="collectionId">
  <input type="hidden" name="request-id" :value="requestId">

  <header class="flex items-center gap-3 border-b border-base-300 px-4 py-2.5">
    <h2 class="min-w-0 flex-1 truncate text-sm font-medium" x-text="name"></h2>
    <template x-if="collectionName">
      <span class="shrink-0 text-xs text-base-content/70" x-text="collectionName"></span>
    </template>
    {{/* Server-rendered, not Alpine: htmx binds the change handler when the
         fragment is swapped in, so the attribute has to be there already. */}}
    {{- if .Envs }}
      <select name="env" title="Environment used to resolve {{ "{{variables}}" }}"
              class="select select-xs w-auto shrink-0"
              hx-post="/api/collections/{{ .CollectionID }}/env"
              hx-trigger="change" hx-swap="none"
              hx-indicator="this" hx-disabled-elt="this">
        <option value=""{{ if not .Env }} selected{{ end }}>No environment</option>
        {{- range .Envs }}
          <option value="{{ . }}"{{ if eq . $.Env }} selected{{ end }}>{{ . }}</option>
        {{- end }}
      </select>
    {{- end }}
  </header>

  <div class="flex items-center gap-2 px-4 py-3">
    <select name="method" x-model="method" class="select select-sm w-auto font-semibold">
      <template x-for="verb in methods" :key="verb">
        <option :value="verb" x-text="verb"></option>
      </template>
    </select>

    <input type="text" name="url" x-model="url" spellcheck="false"
           placeholder="https://api.example.com/users  or  {{ "{{baseUrl}}" }}/users"
           class="input input-sm min-w-0 flex-1 font-mono">

    <button type="submit" id="send-button" class="btn btn-sm btn-primary shrink-0">
      <svg id="send-indicator" class="htmx-indicator size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-opacity="0.3"/>
        <path d="M21 12a9 9 0 00-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      </svg>
      Send
    </button>
  </div>

  <nav role="tablist" class="tabs tabs-border px-4">
    <template x-for="item in tabs" :key="item.id">
      <button type="button" role="tab" @click="tab = item.id"
              class="tab gap-1.5 text-xs font-medium"
              :class="tab === item.id && 'tab-active'">
        <span x-text="item.label"></span>
        <span x-show="count(item.id)" class="badge badge-xs badge-neutral badge-soft" x-text="count(item.id)"></span>
      </button>
    </template>
  </nav>

  <div class="min-h-0 flex-1 overflow-auto px-4 py-3">
    <div x-show="tab === 'params'">
      {{- template "kvrows" (rows "param" "params" "Query parameter") }}
    </div>

    <div x-show="tab === 'headers'">
      {{- template "kvrows" (rows "header" "headers" "Header") }}
    </div>

    <div x-show="tab === 'body'" class="space-y-3">
      <div class="flex items-center gap-2">
        <select name="body-mode" x-model="body.mode" class="select select-xs w-auto">
          <option value="none">No body</option>
          <option value="raw">Raw</option>
          <option value="form-urlencoded">Form URL encoded</option>
          <option value="multipart-form">Multipart form</option>
        </select>
        <select name="body-type" x-model="body.type" x-show="body.mode === 'raw'" class="select select-xs w-auto">
          <option value="application/json">application/json</option>
          <option value="application/xml">application/xml</option>
          <option value="text/plain">text/plain</option>
          <option value="application/javascript">application/javascript</option>
        </select>
      </div>

      <textarea name="body-raw" x-model="body.raw" x-show="body.mode === 'raw'" spellcheck="false" rows="12"
                placeholder="Request payload"
                class="textarea w-full resize-y font-mono text-xs leading-relaxed"></textarea>

      <div x-show="body.mode === 'form-urlencoded' || body.mode === 'multipart-form'">
        {{- template "kvrows" (rows "form" "body.form" "Field") }}
      </div>

      <p x-show="body.mode === 'none'" class="text-xs text-base-content/70">This request is sent without a body.</p>
    </div>

    <div x-show="tab === 'auth'" class="max-w-xl space-y-3">
      <select name="auth-type" x-model="auth.type" class="select select-xs w-auto">
        <option value="none">No auth</option>
        <option value="inherit">Inherit from collection</option>
        <option value="bearer">Bearer token</option>
        <option value="basic">Basic</option>
        <option value="apikey">API key</option>
      </select>

      <div x-show="auth.type === 'bearer'">
        <label class="mb-1 block text-xs text-base-content/70">Token</label>
        <input type="text" name="auth-token" x-model="auth.token" spellcheck="false"
               class="input input-xs w-full font-mono">
      </div>

      <div x-show="auth.type === 'basic'" class="grid grid-cols-2 gap-3">
        <div>
          <label class="mb-1 block text-xs text-base-content/70">Username</label>
          <input type="text" name="auth-username" x-model="auth.username" spellcheck="false"
                 class="input input-xs w-full font-mono">
        </div>
        <div>
          <label class="mb-1 block text-xs text-base-content/70">Password</label>
          <input type="password" name="auth-password" x-model="auth.password"
                 class="input input-xs w-full font-mono">
        </div>
      </div>

      <div x-show="auth.type === 'apikey'" class="grid grid-cols-3 gap-3">
        <div>
          <label class="mb-1 block text-xs text-base-content/70">Key</label>
          <input type="text" name="auth-key" x-model="auth.key" spellcheck="false"
                 class="input input-xs w-full font-mono">
        </div>
        <div>
          <label class="mb-1 block text-xs text-base-content/70">Value</label>
          <input type="text" name="auth-value" x-model="auth.value" spellcheck="false"
                 class="input input-xs w-full font-mono">
        </div>
        <div>
          <label class="mb-1 block text-xs text-base-content/70">Add to</label>
          <select name="auth-in" x-model="auth.in" class="select select-xs w-full">
            <option value="header">Header</option>
            <option value="query">Query</option>
          </select>
        </div>
      </div>

      <p x-show="auth.type === 'inherit'" class="text-xs text-base-content/70">
        Collection-level auth is not applied yet; set it explicitly for now.
      </p>
    </div>
  </div>
</form>
{{- end -}}


{{- define "kvrows" -}}
<div class="space-y-1.5">
  <template x-for="(row, i) in {{ .Model }}" :key="i">
    <div class="flex items-center gap-2">
      <input type="hidden" name="{{ .Prefix }}-on" :value="row.enabled ? '1' : '0'">
      <input type="checkbox" x-model="row.enabled" :title="row.enabled ? 'Enabled' : 'Disabled'"
             class="checkbox checkbox-xs checkbox-primary shrink-0">
      <input type="text" name="{{ .Prefix }}-key" x-model="row.key" spellcheck="false" placeholder="{{ .Label }}"
             class="input input-xs w-1/3 min-w-0 font-mono"
             :class="!row.enabled && 'opacity-50'">
      <input type="text" name="{{ .Prefix }}-value" x-model="row.value" spellcheck="false" placeholder="Value"
             class="input input-xs min-w-0 flex-1 font-mono"
             :class="!row.enabled && 'opacity-50'">
      <button type="button" @click="{{ .Model }}.splice(i, 1)" title="Remove"
              class="btn btn-xs btn-ghost btn-square shrink-0">
        <svg class="size-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 3l8 8M11 3l-8 8"/>
        </svg>
      </button>
    </div>
  </template>
  <button type="button" @click="{{ .Model }}.push({ key: '', value: '', enabled: true })"
          class="btn btn-xs btn-ghost">+ Add</button>
</div>
{{- end -}}
