{{- define "response.gohtml" -}}
{{- if .Error -}}
  <div class="flex h-full flex-col">
    <header class="flex items-center gap-2 border-b border-base-300 px-4 py-2.5">
      <span class="badge badge-sm badge-error font-semibold">Failed</span>
    </header>
    <div class="min-h-0 flex-1 overflow-auto p-4">
      <p class="font-mono text-xs leading-relaxed">{{ .Error }}</p>
    </div>
  </div>
{{- else -}}
  <div class="flex h-full flex-col" x-data="{ tab: 'body' }">
    <header class="flex flex-wrap items-center gap-3 border-b border-base-300 px-4 py-2.5">
      {{/* Solid badges: the pastel Nord accents only carry enough contrast
           against their own -content colour, not against base-100. */}}
      <span class="badge badge-sm font-semibold
        {{- if eq .StatusTone "ok" }} badge-success
        {{- else if eq .StatusTone "redirect" }} badge-info
        {{- else if eq .StatusTone "client" }} badge-warning
        {{- else }} badge-error{{ end }}">{{ .Status }}</span>

      <span class="text-xs text-base-content/70">{{ .Duration }}</span>
      <span class="text-xs text-base-content/70">{{ .Size }}</span>
      {{- if .ContentType }}<span class="truncate text-xs text-base-content/70">{{ .ContentType }}</span>{{ end }}

      <nav role="tablist" class="tabs tabs-box tabs-xs ml-auto">
        <button type="button" role="tab" @click="tab = 'body'"
                class="tab" :class="tab === 'body' && 'tab-active'">Body</button>
        <button type="button" role="tab" @click="tab = 'headers'"
                class="tab" :class="tab === 'headers' && 'tab-active'">Headers ({{ len .Headers }})</button>
      </nav>
    </header>

    <div class="min-h-0 flex-1 overflow-auto">
      <div x-show="tab === 'body'" class="p-4">
        {{- if not .Printable }}
          <p class="text-xs text-base-content/70">Binary response ({{ .Size }}) — not shown.</p>
        {{- else if eq .Body "" }}
          <p class="text-xs text-base-content/70">Empty response body.</p>
        {{- else }}
          {{- if .Truncated }}
            <p class="mb-2"><span class="badge badge-xs badge-warning">Response truncated for display</span></p>
          {{- end }}
          <pre class="whitespace-pre-wrap break-words font-mono text-xs leading-relaxed">{{ .Body }}</pre>
        {{- end }}
      </div>

      <div x-show="tab === 'headers'" class="p-4">
        <dl class="space-y-1">
          {{- range .Headers }}
            <div class="flex gap-3 font-mono text-xs">
              <dt class="w-56 shrink-0 truncate text-base-content/70">{{ .Name }}</dt>
              <dd class="min-w-0 break-all">{{ .Value }}</dd>
            </div>
          {{- end }}
        </dl>
        <p class="mt-4 border-t border-base-300 pt-3 font-mono text-[11px] text-base-content/70">
          {{ .SentMethod }} {{ .SentURL }} &middot; {{ .Proto }}
        </p>
      </div>
    </div>
  </div>
{{- end -}}
{{- end -}}
