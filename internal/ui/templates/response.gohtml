{{- define "response.gohtml" -}}
{{- if .Error -}}
  <div class="flex h-full flex-col">
    <header class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2.5">
      <span class="rounded bg-rose-500/15 px-2 py-0.5 text-xs font-semibold text-rose-300">Failed</span>
    </header>
    <div class="min-h-0 flex-1 overflow-auto p-4">
      <p class="font-mono text-xs leading-relaxed text-rose-300">{{ .Error }}</p>
    </div>
  </div>
{{- else -}}
  <div class="flex h-full flex-col" x-data="{ tab: 'body' }">
    <header class="flex flex-wrap items-center gap-3 border-b border-zinc-800 px-4 py-2.5">
      <span class="rounded px-2 py-0.5 text-xs font-semibold
        {{- if eq .StatusTone "ok" }} bg-emerald-500/15 text-emerald-300
        {{- else if eq .StatusTone "redirect" }} bg-sky-500/15 text-sky-300
        {{- else if eq .StatusTone "client" }} bg-amber-500/15 text-amber-300
        {{- else }} bg-rose-500/15 text-rose-300{{ end }}">{{ .Status }}</span>

      <span class="text-xs text-zinc-500">{{ .Duration }}</span>
      <span class="text-xs text-zinc-500">{{ .Size }}</span>
      {{- if .ContentType }}<span class="truncate text-xs text-zinc-600">{{ .ContentType }}</span>{{ end }}

      <nav class="ml-auto flex gap-1">
        <button type="button" @click="tab = 'body'"
                class="rounded px-2 py-1 text-xs"
                :class="tab === 'body' ? 'bg-zinc-800 text-zinc-100' : 'text-zinc-500 hover:text-zinc-300'">Body</button>
        <button type="button" @click="tab = 'headers'"
                class="rounded px-2 py-1 text-xs"
                :class="tab === 'headers' ? 'bg-zinc-800 text-zinc-100' : 'text-zinc-500 hover:text-zinc-300'">Headers ({{ len .Headers }})</button>
      </nav>
    </header>

    <div class="min-h-0 flex-1 overflow-auto">
      <div x-show="tab === 'body'" class="p-4">
        {{- if not .Printable }}
          <p class="text-xs text-zinc-500">Binary response ({{ .Size }}) — not shown.</p>
        {{- else if eq .Body "" }}
          <p class="text-xs text-zinc-500">Empty response body.</p>
        {{- else }}
          {{- if .Truncated }}
            <p class="mb-2 text-xs text-amber-400">Response truncated for display.</p>
          {{- end }}
          <pre class="whitespace-pre-wrap break-words font-mono text-xs leading-relaxed text-zinc-200">{{ .Body }}</pre>
        {{- end }}
      </div>

      <div x-show="tab === 'headers'" class="p-4">
        <dl class="space-y-1">
          {{- range .Headers }}
            <div class="flex gap-3 font-mono text-xs">
              <dt class="w-56 shrink-0 truncate text-zinc-500">{{ .Name }}</dt>
              <dd class="min-w-0 break-all text-zinc-300">{{ .Value }}</dd>
            </div>
          {{- end }}
        </dl>
        <p class="mt-4 border-t border-zinc-800 pt-3 font-mono text-[11px] text-zinc-600">
          {{ .SentMethod }} {{ .SentURL }} &middot; {{ .Proto }}
        </p>
      </div>
    </div>
  </div>
{{- end -}}
{{- end -}}
